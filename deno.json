{
  "name": "@dx/alpine-server",
  "version": "0.3.0-alpha.1",
  "license": "MIT",
  "nodeModulesDir": "none",
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-net --allow-env",
    "check": "deno fmt --check && deno lint",
    "example": "cd example && deno run --allow-net --allow-read --allow-run --allow-env app.ts",
    "update": "deno outdated --update --latest && deno run --allow-net --allow-read --allow-write ./scripts/update-alpine-version.ts"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.13",
    "@hono/node-server": "npm:@hono/node-server@^2.1.4",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "linkedom": "npm:linkedom@^0.18.13"
  },
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli/cli.ts",
    "./create": "./cli/create.ts",
    "./hono": "./src/hono.ts"
  },
  "publish": {
    "exclude": [
      ".claude",
      ".coderabbit.yaml",
      "CLAUDE.md",
      ".github",
      ".vscode",
      ".githooks",
      "example",
      "scripts",
      ".gitignore",
      ".editorconfig",
      ".npmrc",
      "deno.lock",
      "package.json",
      "package-lock.json",
      "bun.lock",
      "node_modules",
      "**/*.test.ts",
      "src/test"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 240,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
